{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "会话分支管理器",
  "version": "2.3.5",
  "identifier": "com.workbuddy.session-branch",
  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "会话分支管理器",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#F7F8FB"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "../assets/icon-128.png",
      "../assets/icon-256.png",
      "../assets/app.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256"
    }
  }
}
